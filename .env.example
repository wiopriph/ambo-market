# ── Supabase (обязательно) ────────────────────────────────────────────────
# URL и ключи проекта: Supabase Dashboard → Project Settings → API
NUXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NUXT_PUBLIC_SUPABASE_KEY=your-anon-public-key
NUXT_SUPABASE_SERVICE_KEY=your-service-role-key

# ── Приложение (обязательно) ──────────────────────────────────────────────
# Публичный базовый URL — используется в SEO-мете, sitemap, ссылках "поделиться"
NUXT_PUBLIC_APP_BASE_URL=http://localhost:3000

# ── Аналитика (необязательно) ─────────────────────────────────────────────
# Google Tag Manager. Пусто/false — GTM не грузится.
NUXT_PUBLIC_GTM_ID=
NUXT_PUBLIC_GTM_ENABLED=false

# Google AdSense (необязательно)
NUXT_GOOGLE_ADSENSE_ID=
